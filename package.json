{
  "name": "distrisec",
  "private": true,
  "version": "0.1.0",
  "description": "Distributed Identity & Data Security Platform",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . --ext .ts",
    "clean": "npm run clean --workspaces --if-present && rimraf node_modules"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.1",
    "vitest": "^2.1.3",
    "eslint": "^9.12.0",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "rimraf": "^6.0.1",
    "@types/node": "^22.7.5"
  },
  "engines": { "node": ">=20.0.0" }
}
